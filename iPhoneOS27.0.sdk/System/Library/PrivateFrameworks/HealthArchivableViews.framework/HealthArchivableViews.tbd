                            HAVFakeHeartRateGenerator._currentBPM,
                            HAVFakeHeartRateGenerator._timer,
                            HAVHeartRateDailyRangeTextProvider._bundle,
                            HAVHeartRateDailyRangeTextProvider._fontSize,
                            HAVHeartRateDailyRangeTextProvider._hasRange,
                            HAVHeartRateDailyRangeTextProvider._healthStore,
                            HAVHeartRateDailyRangeTextProvider._isPlaceholder,
                            HAVHeartRateDailyRangeTextProvider._maximumBPM,
                            HAVHeartRateDailyRangeTextProvider._minimumBPM,
                            HAVHeartRateTextProvider._bundle,
                            HAVHeartRateTextProvider._fontSize,
                            HAVHeartRateTextProvider._fontWeight,
                            HAVHeartRateTextProvider._hasCustomFontWeight,
                            HAVHeartRateTextProvider._isPlaceholder,
                            HAVHeartRateTextProvider._showsBPMSuffix,
                            _HAVHeartRateCoordinator._cachedHeartRate,
                            _HAVHeartRateCoordinator._consumers,
                            _HAVHeartRateCoordinator._fakeHeartRatesPreferenceObserver,
                            _HAVHeartRateCoordinator._hasConfiguredDataSource,
                            _HAVHeartRateCoordinator._heartRateRequestor,
                            _HAVHeartRateCoordinator._lastHeartRateTimestamp,
                            _HAVHeartRateCoordinator._staleUpdateTimer,
                            _HAVHeartRateCoordinator._usingFakeData ]
...
