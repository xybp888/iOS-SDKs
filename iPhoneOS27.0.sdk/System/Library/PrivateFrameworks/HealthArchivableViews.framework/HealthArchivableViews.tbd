                            HAVHeartRateDailyRangeTextProvider,
                            HAVHeartRateTextProvider, _HAVHeartRateCoordinator,
                            _TtC21HealthArchivableViews21LiveHeartRateReceiver,
                            _TtC21HealthArchivableViews37HAVHeartRateObservableBoolUserDefault ]
