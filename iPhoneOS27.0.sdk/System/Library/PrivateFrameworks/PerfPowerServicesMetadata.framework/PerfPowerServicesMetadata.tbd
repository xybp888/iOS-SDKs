                            PPSAccessoryUsageSummaryMetrics,
                            PPSApplicationMetrics, PPSAudioMetrics,
                            PPSBGProcessingCommonMetrics, PPSBacklightMetrics,
                            PPSBackupMetrics, PPSBasebandMetrics,
                            PPSBatteryMetrics, PPSButtonMetrics, PPSCadence,
                            PPSCadenceTuple, PPSCameraCaptureMetrics,
                            PPSClientInterface, PPSConfigMetrics, PPSCoreLocation,
                            PPSCoreRoutineMetrics, PPSDisplayMetrics,
                            PPSDownloadMetrics, PPSFileUtilities,
                            PPSGenerativeFunctionMetrics, PPSIOReportMetrics,
                            PPSLocaleMetrics, PPSMapsMetrics, PPSMessageMetrics,
                            PPSMetadataStore, PPSMetric, PPSMetricExtras,
                            PPSMetricManager, PPSMetricType,
                            PPSNetworkRelayMetrics, PPSPBCadence,
                            PPSPBCadenceTuple, PPSPBEnumMapping, PPSPBEnumTuple,
                            PPSPBGroupingDimensions, PPSPBMetric,
                            PPSPBMetricHistory, PPSPBMetricStream, PPSPBMetricType,
                            PPSPBRounding, PPSPBSource, PPSPBUnit, PPSPMUMetrics,
                            PPSPerformanceMetrics, PPSPooledConnection,
                            PPSRenderMetrics, PPSRounding, PPSSMCMetrics,
                            PPSSQLMetadataStore, PPSSQLiteConnectionPool,
                            PPSSensorsMetrics, PPSSleepMetrics,
                            PPSStatusKitAgentMetrics, PPSStorageMetrics,
                            PPSSysctlMetrics, PPSUIKitMetrics, PPSUnit, PPSUtilities,
                            PPSWidgetMetrics, PPSWifiMetrics, PPSXPCMetrics ]
    objc-ivars:           [ PPSCadence._cadenceTuples, PPSCadenceTuple._type,
                            PPSCadenceTuple._value,
                            PPSMetadataStore._metadataHistoryCache,
                            PPSMetadataStore._metricsByID,
                            PPSMetric._DMACompliant, PPSMetric._appIdentifier,
                            PPSMetric._auxiliaryType, PPSMetric._build,
                            PPSMetric._cadence, PPSMetric._category,
                            PPSMetric._datatype, PPSMetric._deviceCapability,
                            PPSMetric._directionality,
                            PPSMetric._enabledPopulation, PPSMetric._extras,
                            PPSMetric._filterEntryLogging,
                            PPSMetric._fixedArraySize, PPSMetric._mode,
                            PPSMetric._name, PPSMetric._obfuscation,
                            PPSMetric._privacyClassification, PPSMetric._source,
                            PPSMetric._storage, PPSMetric._subsystem,
                            PPSMetric._timeToLive, PPSMetric._unit,
                            PPSMetric._version, PPSMetricExtras._enumMapping,
                            PPSMetricExtras._groupBy, PPSMetricExtras._indexKey,
                            PPSMetricExtras._metricType,
                            PPSMetricExtras._rounding, PPSMetricType._category,
                            PPSMetricType._value, PPSPBCadence._cadences,
                            PPSPBCadenceTuple._has, PPSPBCadenceTuple._type,
                            PPSPBCadenceTuple._value, PPSPBEnumMapping._enumMaps,
                            PPSPBEnumTuple._key, PPSPBEnumTuple._value,
                            PPSPBGroupingDimensions._groupBys,
                            PPSPBMetric._appIdentifier,
                            PPSPBMetric._auxiliaryType, PPSPBMetric._build,
                            PPSPBMetric._cadence, PPSPBMetric._category,
                            PPSPBMetric._datatype, PPSPBMetric._deviceCapability,
                            PPSPBMetric._directionality,
                            PPSPBMetric._dmaCompliant,
                            PPSPBMetric._enabledPopulation,
                            PPSPBMetric._enumMapping, PPSPBMetric._exampleValue,
                            PPSPBMetric._filterEntryLogging,
                            PPSPBMetric._fixedArraySize, PPSPBMetric._groupBy,
                            PPSPBMetric._has, PPSPBMetric._metricDescription,
                            PPSPBMetric._metricType, PPSPBMetric._mode,
                            PPSPBMetric._name, PPSPBMetric._obfuscation,
                            PPSPBMetric._privacyClassification,
                            PPSPBMetric._rounding, PPSPBMetric._source,
                            PPSPBMetric._storage, PPSPBMetric._subsystem,
                            PPSPBMetric._timeToLive, PPSPBMetric._unit,
                            PPSPBMetric._version, PPSPBMetricHistory._metrics,
                            PPSPBMetricStream._has,
                            PPSPBMetricStream._metricHistorys,
                            PPSPBMetricStream._protoVersion,
                            PPSPBMetricType._category, PPSPBMetricType._has,
                            PPSPBMetricType._value, PPSPBRounding._has,
                            PPSPBRounding._type, PPSPBRounding._value,
                            PPSPBSource._source, PPSPBUnit._symbol,
                            PPSPooledConnection._connection,
                            PPSPooledConnection._lastAccessTime,
                            PPSPooledConnection._lockDepth,
                            PPSPooledConnection._pendingEviction,
                            PPSPooledConnection._recursiveLock,
                            PPSRounding._type, PPSRounding._value,
                            PPSSQLiteConnectionPool._connections,
                            PPSSQLiteConnectionPool._entriesLock,
                            PPSSQLiteConnectionPool._maxPoolSize,
