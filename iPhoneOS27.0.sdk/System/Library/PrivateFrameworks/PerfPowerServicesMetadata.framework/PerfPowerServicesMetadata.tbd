--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/PerfPowerServicesMetadata.framework/PerfPowerServicesMetadata
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _PPSClientInterfaceLog, _PPSMetricLog,
                            _PPSPBCadenceReadFrom, _PPSPBCadenceTupleReadFrom,
                            _PPSPBEnumMappingReadFrom, _PPSPBEnumTupleReadFrom,
                            _PPSPBGroupingDimensionsReadFrom,
                            _PPSPBMetricHistoryReadFrom, _PPSPBMetricReadFrom,
                            _PPSPBMetricStreamReadFrom, _PPSPBMetricTypeReadFrom,
                            _PPSPBRoundingReadFrom, _PPSPBSourceReadFrom,
                            _PPSPBUnitReadFrom, _PPSStorageLog, _PPSStoreLog,
                            _columnNamesForStatement, _logHandle,
                            _performStatement, _valueForStatementColumn ]
