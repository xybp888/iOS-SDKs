--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/AXSoundDetection.framework/AXSoundDetection
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _AXIsSoundDetectionMedinaSupportEnabled,
                            _AXSDDetectorCategoryAlarm,
                            _AXSDDetectorCategoryAnimal,
                            _AXSDDetectorCategoryHousehold,
                            _AXSDDetectorCategoryNone,
                            _AXSDDetectorCategoryPeople,
                            _AXSDIsConnectedToCarPlay,
                            _AXSDKShotGeneralApplianceFileName,
                            _AXSDKShotHallucinatorFileName,
                            _AXSDKShotIsValidIdentifier, _AXSDKShotModelBasePath,
                            _AXSDKShotModelExtension,
                            _AXSDKShotModelWeightsFileName,
                            _AXSDKShotSafePathWithinBase,
                            _AXSDSettingsEventSourceControlCenterHearingDevices,
                            _AXSDSettingsEventSourceControlCenterLiveListen,
                            _AXSDSettingsEventSourceControlCenterSoundRecognition,
                            _AXSDSettingsEventSourceDataMigrator,
                            _AXSDSettingsEventSourceInternal,
                            _AXSDSettingsEventSourceSettingsApp,
                            _AXSDSettingsEventSourceShortcutsApp,
                            _AXSDSettingsEventSourceUnknown,
                            _AXSDSoundDetectionBundle,
                            _AXSDSoundDetectionCategories,
                            _AXSDSoundDetectionHandleNotificationsForResponse,
                            _AXSDSoundDetectionKShotTypeGeneralAppliance,
                            _AXSDSoundDetectionKShotTypeHallucinator,
                            _AXSDSoundDetectionKShotTypeModelWeights,
                            _AXSDSoundDetectionLocalizedStringForCategory,
                            _AXSDSoundDetectionLocalizedStringForType,
                            _AXSDSoundDetectionLocalizedStringForTypeFromSource,
                            _AXSDSoundDetectionLocalizedTitleForType,
                            _AXSDSoundDetectionMessageKeyConfidence,
                            _AXSDSoundDetectionMessageKeyType,
                            _AXSDSoundDetectionTypeApplianceBeeps,
                            _AXSDSoundDetectionTypeApplianceBellDings,
                            _AXSDSoundDetectionTypeApplianceBuzzes,
                            _AXSDSoundDetectionTypeCarHorns,
                            _AXSDSoundDetectionTypeCatMeows,
                            _AXSDSoundDetectionTypeCough,
                            _AXSDSoundDetectionTypeDistressedBaby,
                            _AXSDSoundDetectionTypeDogBarks,
                            _AXSDSoundDetectionTypeDoorKnocks,
                            _AXSDSoundDetectionTypeDoorbells,
                            _AXSDSoundDetectionTypeFireAlarms,
                            _AXSDSoundDetectionTypeForIdentifier,
                            _AXSDSoundDetectionTypeGlassBreaking,
                            _AXSDSoundDetectionTypeIsAppliance,
                            _AXSDSoundDetectionTypeKShot,
                            _AXSDSoundDetectionTypeKettle,
                            _AXSDSoundDetectionTypeNone,
                            _AXSDSoundDetectionTypePersonShouting,
                            _AXSDSoundDetectionTypeSirenAlarms,
                            _AXSDSoundDetectionTypeSmokeAlarms,
                            _AXSDSoundDetectionTypeWaterRunning,
                            _AXSDSoundDetectionTypesForCategory,
                            _AXSoundDetectionSupportsVirtualAudioDevice,
                            _AXSoundDetectionVersionNumber,
                            _AXSoundDetectionVersionString,
                            __AXDetectionBodyLocalizedFormatFor,
                            __AXSDSoundDetectionGatherFilesAndGenerateRadarForNotificationAt,
                            _bmTypeForSoundDetectionType,
                            _kAXSAllowForwardingSoundRecognitionToSupportedWatch,
                            _kAXSEnabledSoundDetectionStatePreference,
                            _kAXSEnabledSoundDetectionTypesPreference,
                            _kAXSSoundDetectionKShotCustomPipedInFile,
                            _kAXSSoundDetectionKShotDetectors,
                            _kAXSSoundDetectionKShotEnabledDetectorIdentifiers,
                            _kAXSSoundDetectionKShotListeningStateIdentifier,
                            _kAXSSoundDetectionKShotRecordings,
                            _kAXSSoundDetectionKShotShouldSaveCurrentSoundIdentifier,
                            _kAXSSoundDetectionKShotTrainingState,
                            _kAXSSoundDetectionKShotisActivelyTrainingAKShotModelIdentifier,
                            _kAXSSoundDetectionLatestSettingsEvents,
                            _kAXSSoundDetectionMedinaSupportForced,
                            _kAXSSoundDetectionMicDisabled,
                            _kAXSSoundDetectionPipedInFile,
                            _kAXSSoundDetectionRetrainModel,
                            _kAXSSoundDetectionSnoozeDictionary,
                            _kAXSSoundDetectionSupportedTypes,
                            _kAXSSoundDetectionTargetKShotDetectorIdentifier,
                            _kAXSUltronEnabledPreference,
                            _kAXSUltronRunningStatus ]
    objc-classes:         [ AXSDDetector, AXSDKShotDetector, AXSDSettings,
                            AXSDSettingsEvent ]
    objc-ivars:           [ AXSDDetector._enabled, AXSDDetector._identifier,
                            AXSDDetector._model, AXSDDetector._modelName,
                            AXSDDetector._needsUpdate,
                            AXSDKShotDetector._customName,
                            AXSDKShotDetector._kshotCategory,
                            AXSDKShotDetector._lastAttemptedTrainingDate,
                            AXSDKShotDetector._modelFailed,
                            AXSDKShotDetector._trainings,
                            AXSDSettings._lastCompanionSyncSnapshot,
                            AXSDSettingsEvent._enabledCustomSounds,
                            AXSDSettingsEvent._enabledSystemSounds,
                            AXSDSettingsEvent._processName,
                            AXSDSettingsEvent._source, AXSDSettingsEvent._state,
                            AXSDSettingsEvent._timestamp ]
...
