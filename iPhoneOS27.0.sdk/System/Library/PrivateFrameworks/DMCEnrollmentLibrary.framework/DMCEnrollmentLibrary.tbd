                            DMCMigrationFlowController._migrationCompletionHandler,
                            DMCMigrationFlowController._originEnrollmentType,
                            DMCMigrationFlowController._pendingCloudConfig,
                            DMCMigrationFlowController._presenter,
                            DMCMigrationFlowController._unenrollmentFlowController,
                            DMCRapidReturnToServiceFlowController._bootstrapToken,
                            DMCRapidReturnToServiceFlowController._delegate,
                            DMCRapidReturnToServiceFlowController._mdmProfileData,
                            DMCRapidReturnToServiceFlowController._networkMonitor,
                            DMCRapidReturnToServiceFlowController._preserveDataPlan,
                            DMCRapidReturnToServiceFlowController._shouldRetryEnrollment,
                            DMCRapidReturnToServiceFlowController._stateMachine,
