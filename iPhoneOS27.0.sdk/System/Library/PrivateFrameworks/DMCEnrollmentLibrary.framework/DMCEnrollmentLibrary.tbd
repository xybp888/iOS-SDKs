                            DMCEnrollmentFlowController._authTokens,
                            DMCEnrollmentFlowController._authenticationResults,
                            DMCEnrollmentFlowController._cleanupIfFail,
                            DMCEnrollmentFlowController._cloudConfig,
                            DMCEnrollmentFlowController._cloudConfigIndicatesRapidReturnToService,
                            DMCEnrollmentFlowController._credentialsError,
                            DMCEnrollmentFlowController._delegate,
                            DMCEnrollmentFlowController._devicePasscode,
                            DMCEnrollmentFlowController._devicePasscodeContext,
                            DMCEnrollmentFlowController._devicePasscodeExtractable,
                            DMCEnrollmentFlowController._dirtyState,
                            DMCEnrollmentFlowController._dynamicRestartInterval,
                            DMCEnrollmentFlowController._enrollmentCompletionHandler,
                            DMCEnrollmentFlowController._enrollmentFlowMonitorStarted,
                            DMCEnrollmentFlowController._enrollmentFlowUUID,
                            DMCEnrollmentFlowController._enrollmentMethod,
                            DMCEnrollmentFlowController._enrollmentType,
                            DMCEnrollmentFlowController._enrollmentURL,
                            DMCEnrollmentFlowController._essoAppITunesStoreID,
                            DMCEnrollmentFlowController._essoDetails,
                            DMCEnrollmentFlowController._extensionIdentifiersFromConfig,
                            DMCEnrollmentFlowController._friendlyName,
                            DMCEnrollmentFlowController._hasBlockedMDMCommands,
                            DMCEnrollmentFlowController._hasEnabledPushWake,
                            DMCEnrollmentFlowController._hasExecutedUIStep,
                            DMCEnrollmentFlowController._isDoingReturnToService,
                            DMCEnrollmentFlowController._isPostBuddy,
                            DMCEnrollmentFlowController._isPostRestoration,
                            DMCEnrollmentFlowController._isProfileLocked,
                            DMCEnrollmentFlowController._isRenewalFlow,
                            DMCEnrollmentFlowController._loggingSupport,
                            DMCEnrollmentFlowController._managedAppleID,
                            DMCEnrollmentFlowController._managedConfigurationHelper,
                            DMCEnrollmentFlowController._migrationDelegate,
                            DMCEnrollmentFlowController._minimumRestartInterval,
                            DMCEnrollmentFlowController._noCompletionScene,
                            DMCEnrollmentFlowController._obliterationShelter,
