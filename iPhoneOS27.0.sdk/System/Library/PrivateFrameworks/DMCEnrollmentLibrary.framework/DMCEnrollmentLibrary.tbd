                            DMCEnrollmentFlowController._presenter,
                            DMCEnrollmentFlowController._profileData,
                            DMCEnrollmentFlowController._profileIdentifier,
                            DMCEnrollmentFlowController._restartIfFail,
                            DMCEnrollmentFlowController._restartInterval,
                            DMCEnrollmentFlowController._restartScheduled,
                            DMCEnrollmentFlowController._rmAccountIdentifier,
                            DMCEnrollmentFlowController._rmStoreHelper,
                            DMCEnrollmentFlowController._serverCapabilities,
                            DMCEnrollmentFlowController._serverInformationSource,
                            DMCEnrollmentFlowController._servers,
                            DMCEnrollmentFlowController._serviceDiscoveryHelper,
                            DMCEnrollmentFlowController._serviceURL,
                            DMCEnrollmentFlowController._softwareUpdateError,
