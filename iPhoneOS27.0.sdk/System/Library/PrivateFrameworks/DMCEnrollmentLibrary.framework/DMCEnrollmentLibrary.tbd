--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/DMCEnrollmentLibrary.framework/DMCEnrollmentLibrary
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _DMCAnalyticsSendEnrollmentEvent,
                            _DMCEnrollmentFlowAppTypeMDMManaged,
                            _DMCEnrollmentFlowAppTypeSystemDeletable,
                            _DMCEnrollmentLibraryVersionNumber,
                            _DMCEnrollmentLibraryVersionString,
                            _DMCWiFiAutoJoinFailedReasonNone,
                            _DMCWiFiAutoJoinFailedReasonUnableToJoinNetwork,
                            _DMCWiFiAutoJoinFailedReasonUnableToTurnOnPower,
                            _kMCBridgeAssignedManagedAppleIDKey,
                            _kMCBridgeEnrollmentModeKey,
                            _kMCBridgeFriendlyNameKey,
                            _kMCBridgeManagedAppleIDKey,
                            _kMCBridgeOrganizationNameKey,
                            _kMCBridgeProfileIdentifierKey,
                            _kMCBridgeRequiredAppIDKey,
                            _kMCBridgeServerCapabilitiesKey,
                            _kRMBridgeAppStoreIDKey, _kRMBridgeBundleIDKey ]
    objc-classes:         [ DMCEnrollmentAccountUtilities,
                            DMCEnrollmentDirtyState, DMCEnrollmentFlowController,
                            DMCEnrollmentFlowControllerBase,
                            DMCMigrationFlowController, DMCMigrationHelper,
                            DMCRapidReturnToServiceFlowController,
                            DMCReturnToServiceHelper, DMCServiceDiscoveryHelper,
                            DMCUnenrollmentFlowController,
                            DMCWiFiAutoJoinStateMachine ]
