--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/WebUI.framework/WebUI
current-version:       1
compatibility-version: 1
reexported-libraries:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    libraries:            [ /System/Library/PrivateFrameworks/SafariShared.framework/SafariShared,
                            /System/Library/PrivateFrameworks/SafariSharedUI.framework/SafariSharedUI ]
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _WBUABAddressKey, _WBUABStreetKey,
                            _WBUAutoFillClearDataClasses,
                            _WBUAutoFillDisableDataClasses,
                            _WBUAutoFillGetEnabledDataClasses,
                            _WBUFeatureManagerCloudTabsAvailabilityDidChangeNotification,
                            _WBUFormAutoFillPasswordGenerationAssistanceBecameAvailableNotification,
                            _WBUFormDataControllerDidSaveAccountWithGeneratedPasswordNotification,
                            _WBUFormDataControllerDidUpdatePasswordForPreviouslySavedAccountNotification,
                            _WBUFormDataControllerNotificationSavedAccount,
                            _WBUHistoryDefaultItemAgeLimit,
                            _WBUHistoryDefaultItemCountLimit,
                            _webuiCookieAcceptPolicyPreferencesKey ]
    objc-classes:         [ WBUAlertController, WBUAutoFillDisplayData,
                            WBUCreditCardDataController, WBUFeatureManager,
                            WBUFormAutoFillPrompt, WBUFormAutoFillWhiteList,
                            WBUFormDataController,
                            WBUFormDataGeneratedPasswordAutoSaveInformation,
                            WBUGeneratedPasswordCredentialUpdateRequest,
                            WBUGeneratedPasswordCredentialUpdater, WBUHistory,
                            WBUPasswordSaveRequestKey, WBUSheetAlertController,
                            WBUSheetController, WebUIAlert, WebUICertificateError,
                            _WBUDynamicMeCard ]
    objc-ivars:           [ WBUAlertController._deallocationHandler,
                            WBUAutoFillDisplayData._fillMatches,
                            WBUAutoFillDisplayData._label,
                            WBUFeatureManager._accountInformationProvider,
                            WBUFeatureManager._appleAccountQueue,
                            WBUFeatureManager._autoFillAvailable,
                            WBUFeatureManager._bookmarksAvailable,
                            WBUFeatureManager._cachedLocallyRestricted,
                            WBUFeatureManager._cloudAccountIsHSA2,
                            WBUFeatureManager._cloudSyncAvailable,
                            WBUFeatureManager._inMemoryBookmarkChangeTrackingAvailable,
                            WBUFeatureManager._isCloudSyncEnabled,
                            WBUFeatureManager._lastRestrictedSettingRequestedTime,
                            WBUFeatureManager._managementState,
                            WBUFeatureManager._offlineReadingListAvailable,
                            WBUFeatureManager._primaryAppleAccount,
                            WBUFeatureManager._readingListAvailable,
                            WBUFeatureManager._screenTimeQueue,
                            WBUFormAutoFillPrompt._alertController,
                            WBUFormAutoFillPrompt._url,
                            WBUFormAutoFillWhiteList._cache,
                            WBUFormDataController._activeSaveRequests,
                            WBUFormDataController._cachedAutoFillRestrictionValue,
                            WBUFormDataController._generatedPassword,
                            WBUFormDataController._informationForGeneratedPasswordAutoSave,
                            WBUFormDataController._keychainCoordinator,
                            WBUFormDataController._lastFilledCreditCardData,
                            WBUFormDataController._lastFilledSavedAccount,
                            WBUFormDataController._passwordSavingExtensionStates,
                            WBUFormDataController._passwordSavingManager,
                            WBUFormDataController._passwordSavingManagerLock,
                            WBUFormDataController._perTabModalPresentationEnabledProvider,
                            WBUFormDataController._previouslyFilledVirtualCardNumbers,
                            WBUFormDataController._savePending,
                            WBUFormDataController._shouldSuppressPasswordSavingPrompts,
                            WBUGeneratedPasswordCredentialUpdateRequest._associatedDomainsManager,
                            WBUGeneratedPasswordCredentialUpdateRequest._generatedPassword,
                            WBUGeneratedPasswordCredentialUpdateRequest._lastGeneratedPassword,
                            WBUGeneratedPasswordCredentialUpdateRequest._protectionSpace,
                            WBUGeneratedPasswordCredentialUpdateRequest._savedAccountContext,
                            WBUGeneratedPasswordCredentialUpdateRequest._shouldSaveExistingCredential,
                            WBUGeneratedPasswordCredentialUpdateRequest._shouldSaveNewCredential,
                            WBUGeneratedPasswordCredentialUpdateRequest._urlForCredential,
                            WBUGeneratedPasswordCredentialUpdateRequest._username,
                            WBUGeneratedPasswordCredentialUpdater._queue,
                            WBUGeneratedPasswordCredentialUpdater._urlsScheduledForUpdating,
                            WBUGeneratedPasswordCredentialUpdater._urlsToUpdateRequests,
                            WBUHistory._shouldScheduleMaintenance,
                            WBUSheetAlertController._alert,
                            WBUSheetAlertController._automaticallyDismiss,
                            WBUSheetAlertController._handler,
                            WBUSheetAlertController._tableView,
                            WBUSheetController._alert,
                            WBUSheetController._alertController,
                            WBUSheetController._alertInvocationQueue,
                            WBUSheetController._delegate,
                            WebUIAlert._actionHandler, WebUIAlert._bodyText,
                            WebUIAlert._context, WebUIAlert._defaultAction,
                            WebUIAlert._hideAction, WebUIAlert._identities,
                            WebUIAlert._indexOfSelectedIdentity,
                            WebUIAlert._otherAction, WebUIAlert._tableAction,
                            WebUIAlert._title, WebUIAlert._titles,
                            WebUIAlert._type,
                            _WBUDynamicMeCard._blocksPendingMeCard,
                            _WBUDynamicMeCard._me,
                            _WBUDynamicMeCard._meCardExists ]
...
