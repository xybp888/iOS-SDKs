--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/SeymourAppStore.framework/SeymourAppStore
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _SeymourAppStoreVersionNumber,
                            _SeymourAppStoreVersionString ]
    objc-classes:         [ _TtC15SeymourAppStore17AppRecordObserver,
                            _TtC15SeymourAppStore33ServiceSubscriptionDialogObserver ]
...
