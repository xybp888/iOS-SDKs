                            DRPeer._requestedDataTypes, DRSPDClient._isActivated,
                            DRSPDClient._requestHandler,
                            DRSPDServer._eventHandler,
                            DRServer._availableDataTypesFromLocalDiscovery,
                            DRServer._availableDataTypesFromServer,
                            DRServer._hidDevices, DRServer._rapportSemaphore,
                            DRServer._wxAddress, DRServerManager._cidDictionary,
                            DRServerManager._clientDictionary,
                            DRServerManager._clientDictionaryQueue,
                            DRServerManager._dispatchQueue,
                            DRServerManager._rapportClient,
                            DRServerManager._wxRoute,
                            DataRelayAnalytics._dataRelaySessionAnalyticDict,
                            DataRelayAnalytics._dispatchQueue,
