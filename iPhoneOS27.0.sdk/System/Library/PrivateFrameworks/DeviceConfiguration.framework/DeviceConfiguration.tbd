                            DCSystemConsumer, DCUserConsumer,
                            _TtC19DeviceConfiguration15ConsumerService,
                            _TtC19DeviceConfiguration15ProviderService,
                            _TtC19DeviceConfiguration15StoreDescriptor,
                            _TtC19DeviceConfiguration15StoreIdentifier,
                            _TtC19DeviceConfiguration16PublisherService,
                            _TtC19DeviceConfiguration16SandboxExtension,
                            _TtC19DeviceConfiguration7Service ]
