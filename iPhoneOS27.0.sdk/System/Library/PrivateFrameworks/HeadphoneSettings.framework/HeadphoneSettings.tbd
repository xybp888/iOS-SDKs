                            BTSDevice._linkedRadioAddress,
                            BTSDevice._relatedFutureRadioAddress,
                            BTSDevice._walletPassUID, BTSDeviceClassic._device,
                            BTSDeviceClassic.accessorySetupKitDisplayName,
                            BTSDeviceClassic.ctkdDevice,
                            BTSDeviceClassic.denyIncomingClassicConnection,
                            BTSDeviceClassic.managedByAliroWallet,
                            BTSDeviceClassic.managedByDeviceAccess,
                            BTSDeviceClassic.managedByWallet,
                            BTSDeviceClassic.supportsBackgroundNI,
                            BTSDeviceLE._centralManager,
                            BTSDeviceLE._channelSoundingL2CAP,
                            BTSDeviceLE._channelSoundingTXQueue,
                            BTSDeviceLE._peripheral,
                            BTSDeviceLE._underlyingDADevice,
                            BTSDeviceLE.ctkdDevice,
                            BTSDeviceLE.denyIncomingClassicConnection,
                            BTSDeviceLE.healthDevice,
                            BTSDeviceLE.managedByAliroWallet,
                            BTSDeviceLE.managedByDeviceAccess,
                            BTSDeviceLE.managedByWallet,
                            BTSDeviceLE.supportsBackgroundNI,
                            HPSConnectedHeadphoneInfo._deviceID,
                            HPSConnectedHeadphoneInfo._deviceImage,
                            HPSConnectedHeadphoneInfo._deviceName,
                            HPSConnectedHeadphoneInfo._deviceSpecifier,
                            HPSConnectedHeadphonesController._avOutputContext,
                            HPSConnectedHeadphonesController._deviceChangeHandler,
                            HPSConnectedHeadphonesController._devices,
                            HPSConnectedHeadphonesController._thirdPartyDatasource,
                            HPSHeadphoneDeepLinkHandler._targetBtAddress,
                            HPSHeadphoneDeepLinkHandler._targetController,
                            HPSThirdPartyHeadphone._avDevice,
                            HPSThirdPartyHeadphone._classicDevice,
                            HPSThirdPartyHeadphone._daDevice,
                            HPSThirdPartyHeadphone._leDevice,
                            HPSThirdPartyHeadphonesDatasource._cachedHeadphones,
                            HPSThirdPartyHeadphonesDatasource._centralManager,
                            HPSThirdPartyHeadphonesDatasource._daSession,
                            HPSThirdPartyHeadphonesDatasource._delegate ]
