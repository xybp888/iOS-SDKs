                            HPSConnectedHeadphoneInfo,
                            HPSConnectedHeadphonesController,
                            HPSHeadphoneDeepLinkHandler, HPSProductUtils,
                            HPSThirdPartyHeadphone,
                            HPSThirdPartyHeadphonesDatasource ]
