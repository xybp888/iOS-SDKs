                            _HKMobileGestaltBridge,
                            _TtC16HealthExperience14MedicalIDCache,
                            _TtC16HealthExperience20UserDefaultsObserver,
                            _TtC16HealthExperience21AsynchronousOperation,
                            _TtC16HealthExperience23MedicalIDFetchOperation,
                            _TtC16HealthExperience25ThreadsafeHKCalendarCache,
                            _TtC16HealthExperience31CloudSyncEventPublisherObserver,
                            _TtC16HealthExperience37FirstRestoreNotInProgressPrecondition,
                            _TtC16HealthExperience38FeatureStatusAdvertisableFeatureSource ]
    objc-ivars:           [ HK_TPSDiscoverabilitySignal._identifier,
                            MedicalIDChangeObserver._delegate,
                            MedicalIDChangeObserver._medicalIDChangedToken ]
...
