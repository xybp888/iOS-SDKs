--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/TrustKit.framework/TrustKit
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _TrustKitVersionNumber, _TrustKitVersionString ]
    objc-classes:         [ TKFDConversationStateWrapper,
                            TKFDImageSpamDecisioningInput, TKFDInference,
                            TKFDOrderSpamDecisioningInput,
                            TKFDTextSpamDecisioningInput,
                            _TtC8TrustKit12ServerClient ]
...
