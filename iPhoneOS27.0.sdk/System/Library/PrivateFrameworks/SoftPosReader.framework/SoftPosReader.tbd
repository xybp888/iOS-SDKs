--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/SoftPosReader.framework/SoftPosReader
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _SPRCardReaderBlobAuthToken,
                            _SPRCardReaderBlobCardholderData,
                            _SPRCardReaderBlobCasdCertificate,
                            _SPRCardReaderBlobDeviceCpuTime,
                            _SPRCardReaderBlobEphemeralPk,
                            _SPRCardReaderBlobFallbackAmount,
                            _SPRCardReaderBlobForFallback,
                            _SPRCardReaderBlobIsPinBypass,
                            _SPRCardReaderBlobIsPinBypassEnabled,
                            _SPRCardReaderBlobIsPinSupported,
                            _SPRCardReaderBlobKeyData,
                            _SPRCardReaderBlobPanKekId,
                            _SPRCardReaderBlobPinBlock,
                            _SPRCardReaderBlobPinCipherBlob,
                            _SPRCardReaderBlobPinData,
                            _SPRCardReaderBlobPinDataBlob,
                            _SPRCardReaderBlobPinKekId,
                            _SPRCardReaderBlobPinKeyBlob,
                            _SPRCardReaderBlobSeAttestation,
                            _SPRCardReaderBlobSeAttestationBlob,
                            _SPRCardReaderBlobSecurePayload,
                            _SPRCardReaderBlobSessionId,
                            _SPRCardReaderBlobSessionToken,
                            _SPRCardReaderBlobSignature,
                            _SPRCardReaderBlobSigningCertificate,
                            _SPRCardReaderBlobTransactionCipherBlob,
                            _SPRCardReaderBlobTransactionData,
                            _SPRCardReaderBlobTransactionDataBlob,
                            _SPRCardReaderBlobTransactionId,
                            _SPRCardReaderBlobTransactionKeyBlob,
                            _SPRCardReaderBlobTransportServerKeyIdentifier,
                            _SPRCardReaderBlobVersionId,
                            _SPRConfigurationStatusConfigNeeded,
                            _SPRConfigurationStatusIsBrokenSeSepPairing,
                            _SPRConfigurationStatusIsJCOPVersionCorrect,
                            _SPRConfigurationStatusIsPasscodeEnabled,
                            _SPRConfigurationStatusIsProductionSigned,
                            _SPRConfigurationStatusIsSeAvailable,
                            _SPRConfigurationStatusIsSecurityViolation,
                            _SPRConfigurationStatusKernelNeeded,
                            _SPRConfigurationStatusKernelUpdateNeeded,
                            _SPRConfigurationStatusKernelVersion,
                            _SPRConfigurationStatusPinAppletNeeded,
                            _SPRConfigurationStatusProfileIDList,
                            _SPRConfigurationStatusSeIdentifier,
                            _SPRConfigurationStatusVersion,
                            _SPRErrorUserInfoKeyDeviceProtectionTimerDuration,
                            _SPRHTTPErrorDomain, _SPRHTTPStatusIsClientError,
                            _SPRHTTPStatusIsServerError, _SPRHTTPStatusIsSuccess,
                            _SPRReadEventCopyDescription,
                            _SPRReaderModeCopyDescription,
                            _SPRTransactionTypeCopyDescription,
                            _SPRUnifiedReaderDelegateEventCopyDescription,
                            _SPRVASTerminalProtocolProtocolFull,
                            _SPRVASTerminalProtocolSignUpOnly, _kORErrorDomain,
                            _kSPRErrorDomain ]
    objc-classes:         [ ORProvisionAppletData, ORProvisionParameters,
                            ORProvisionResult, ORReader, SPRApplicationRecord,
                            SPRAttestationManager, SPRCellSignalMonitor,
                            SPRConfigurator, SPRError, SPRInspector, SPRInstallData,
                            SPRInstallRelay, SPRMPOCMonitorManager, SPRMemoryInfo,
                            SPRMeta, SPRMonitor, SPRMonitorLog, SPRMonitorManager,
                            SPRNFSessionProxy, SPRObject, SPRPINController,
                            SPRPINCrypto, SPRPINData, SPRPINParameter,
                            SPRPersistenceFactory, SPRPersisting, SPRPrimer,
                            SPRProvider, SPRReadParameters, SPRReadRelay, SPRReader,
                            SPRSecureChannel, SPRServiceClient, SPRServiceXPC,
                            SPRTransactionBatchSignature, SPRTransactionData,
                            SPRTransactionDigest, SPRTransactionSignature,
                            SPRUnifiedReader, SPRUnifiedReaderAppletStatus,
                            SPRUnifiedReaderFoundation,
                            SPRUnifiedReaderPINController,
                            SPRUnifiedReaderPINData,
                            SPRUnifiedReaderPINParameter,
                            SPRUnifiedReaderReadParameters,
                            SPRUnifiedReaderTransactionData, SPRVASRequest,
