--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/NanoMediaAPI.framework/NanoMediaAPI
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _MediaAPIAlbumsPathString,
                            _MediaAPIArtistViewsKeyString,
                            _MediaAPIArtistViewsQueryValue,
                            _MediaAPIArtistsPathString,
                            _MediaAPICatalogPathString,
                            _MediaAPICountryCodeBagKey, _MediaAPIDomainDefault,
                            _MediaAPIDomainListenNow, _MediaAPIDomainsBagKey,
                            _MediaAPIEditorialPathString,
                            _MediaAPIGroupingsNameKeyString,
                            _MediaAPIGroupingsPathString,
                            _MediaAPIGroupingsRadioNameBagKey,
                            _MediaAPIHeavyRotationPathString,
                            _MediaAPIHeavyRotationTypesQueryValue,
                            _MediaAPIHistoryPathString,
                            _MediaAPIIncludeKeyString,
                            _MediaAPIIncludeOnlyKeyString,
                            _MediaAPILanguageBagKey, _MediaAPILanguageKeyString,
                            _MediaAPILimitKeyString,
                            _MediaAPIMultiplexPathString,
                            _MediaAPIMultiroomsPathString,
                            _MediaAPIMusicSuperRoomIDBagKey,
                            _MediaAPIMusicWorkoutMediaPlaybackBagKey,
                            _MediaAPIPersonalizedPathString,
                            _MediaAPIPlatformKeyString,
                            _MediaAPIPlaylistsPathString,
                            _MediaAPIRadioStationsPathString,
                            _MediaAPIRadioTypesQueryValue,
                            _MediaAPIRecentPathString, _MediaAPIRoomsPathString,
                            _MediaAPIScheme, _MediaAPISearchPathString,
                            _MediaAPISearchTermKeyString,
                            _MediaAPISearchTypesQueryValue,
                            _MediaAPISearchWithKeyString,
                            _MediaAPISearchWithQueryValue,
                            _MediaAPIStarterPackOver13MultiplexBagKey,
                            _MediaAPIStarterPackUnder13MultiplexBagKey,
                            _MediaAPITypesKeyString,
                            _MusicURLComponentsWithURLBag,
                            _MusicURLPathStorefrontWithURLBag,
                            _MusicURLQueryItemLanguageWithURLBag ]
    objc-classes:         [ NMAPIAnyResponseParser, NMAPIArtistResponseParser,
                            NMAPICollectionResponseParser,
                            NMAPIDefaultSectionedCollectionDataSource,
                            NMAPIFitnessMultiroomRequest,
                            NMAPIHeavyRotationRequest,
                            NMAPIItemListResponseParser,
                            NMAPIMultiplexResponseParser,
                            NMAPIMultiroomResponseParser,
                            NMAPIRadioGenreRoomRequest, NMAPIRadioRequest,
                            NMAPIRadioResponseParser, NMAPIRequest,
                            NMAPIRequestOperation, NMAPIRoomResponseParser,
                            NMAPISectionResult, NMAPIStarterPackMultiplexRequest,
                            NMAPIURLRequest ]
    objc-ivars:           [ NMAPIDefaultSectionedCollectionDataSource._cachedItems,
                            NMAPIDefaultSectionedCollectionDataSource._cachedSections,
                            NMAPIDefaultSectionedCollectionDataSource._importedIdentifierSets,
                            NMAPIDefaultSectionedCollectionDataSource._itemResults,
                            NMAPIDefaultSectionedCollectionDataSource._request,
                            NMAPIDefaultSectionedCollectionDataSource._results,
                            NMAPIDefaultSectionedCollectionDataSource._sectionResultIDs,
                            NMAPIDefaultSectionedCollectionDataSource._sectionResults,
                            NMAPIDefaultSectionedCollectionDataSource._sectionedItemResultIDs,
                            NMAPIDefaultSectionedCollectionDataSource._storeURLBag,
                            NMAPIRadioGenreRoomRequest._URL,
                            NMAPIRequest._cachePolicy, NMAPIRequest._cacheURL,
                            NMAPIRequestOperation._storeURLBag,
                            NMAPISectionResult._itemsArray,
                            NMAPISectionResult._sectionDictionary,
                            NMAPISectionResult._sectionIdentifier,
                            NMAPIStarterPackMultiplexRequest._underageUser,
                            NMAPIURLRequest._URL ]
...
