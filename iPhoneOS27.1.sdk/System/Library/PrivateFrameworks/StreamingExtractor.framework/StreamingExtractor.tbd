--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/StreamingExtractor.framework/StreamingExtractor
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _STAEAExtractorErrorDomain,
                            _STAEAExtractorErrorKeyErrno,
                            _STAEAExtractorOptionsArchiveID,
                            _STAEAExtractorOptionsAsymmetricDecryptionKey,
                            _STAEAExtractorOptionsSigningPublicKey,
                            _STAEAExtractorOptionsSourceDirectory,
                            _STAEAExtractorOptionsSourceDirectorySandboxExtension,
                            _STAEAExtractorOptionsSymmetricDecryptionKey,
                            _STExtractorErrorDomain,
                            _STRemoteExtractorEntitlement,
                            _STRemoteExtractorEntitlementPrivileged,
                            _STRemoteExtractorOptionsDoesConsumeExtractedData,
                            _STRemoteExtractorOptionsPluginBundleName,
                            _STRemoteExtractorOptionsPluginBundlePath,
                            _STRemoteExtractorOptionsPluginDirectory,
                            _STRemoteExtractorOptionsSessionID,
                            _STRemoteExtractorOptionsSuppressCompletionsDuringShutdown,
                            _STRemoteExtractorOptionsUsesReservePolicy,
                            _STReservableSpacePolicyErrorDomain,
                            _StreamingExtractorVersionNumber,
                            _StreamingExtractorVersionString ]
    objc-classes:         [ ExtractionServiceInfo, STExtractionMemoryWaiter,
                            STExtractionOriginator, STRemoteExtractor,
                            STReservableSpacePolicy ]
    objc-ivars:           [ ExtractionServiceInfo._availableExtractionServiceMemory,
                            ExtractionServiceInfo._availableExtractionServiceMemoryLock,
                            ExtractionServiceInfo._pluginBundlePath,
                            ExtractionServiceInfo._uuid,
                            ExtractionServiceInfo._waiters,
                            STExtractionMemoryWaiter._completion,
                            STExtractionMemoryWaiter._extractor,
                            STExtractionMemoryWaiter._targetQueue,
                            STExtractionOriginator._originator,
                            STRemoteExtractor._dataStreamReservationInFlight,
                            STRemoteExtractor._dataStreamStarted,
                            STRemoteExtractor._error,
                            STRemoteExtractor._extractionServiceConnection,
                            STRemoteExtractor._extractionServiceInfo,
                            STRemoteExtractor._extractorDelegate,
                            STRemoteExtractor._finalBytesSent,
                            STRemoteExtractor._internalExtractionOriginator,
                            STRemoteExtractor._ioQueue,
                            STRemoteExtractor._isInvalid,
                            STRemoteExtractor._isPrepared,
                            STRemoteExtractor._lastResumptionOffset,
                            STRemoteExtractor._options,
                            STRemoteExtractor._pendingPostReservationBlocks,
                            STRemoteExtractor._privileged,
                            STRemoteExtractor._requiredExtractionMemory,
                            STRemoteExtractor._reservedExtractionMemory,
                            STReservableSpacePolicy._invalidated,
                            STReservableSpacePolicy._policyType ]
...
