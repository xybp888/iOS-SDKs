--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/RemotePairingDevice.framework/RemotePairingDevice
current-version:       280.0.12
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _InterfaceIndexCorrespondsToAppleNCMInterface,
                            _RPTrustedHostInfoKeyHostModel,
                            _RPTrustedHostInfoKeyHostName,
                            _RPTrustedHostInfoKeyHostSerialNumber,
                            _RPTrustedHostInfoKeyIdentifier,
                            _RPTrustedHostInfoKeyIsPaired,
                            _RPTrustedHostInfoKeyLastUsedDate,
                            _RemotePairingCopyRemoteUnlockDeviceKeyForTunnel,
                            _RemotePairingDeviceVersionNumber,
                            _RemotePairingDeviceVersionString,
                            _RemotePairingGetCurrentWireProtocolVersion,
                            _RemotePairingGetTrustedHostInfoAndReturnError,
                            _RemotePairingGetTrustedHostInfoWithOptionsAndReturnError,
                            _RemotePairingGetUSBConnectedHostTrustState,
                            __RPIsAppleInternal, __RPIsDarwinOS,
                            __RPTextToMACAddress, _createWirelessPairingSession,
                            _createWirelessPairingSessionWithPinHandler,
                            _kRemotePairingAuditLogUpdatedNotificationName,
                            _kRemotePairingHostPairedNotificationName,
                            _kRemotePairingHostPairingUpdatedNotificationName,
                            _kRemotePairingHostUnpairedNotificationName,
                            _kRemotePairingOptPreserveAutomationPairRecords,
                            _kRemotePairingTrustedHostsUpdatedNotificationName,
                            _remotePairingIsEnabled,
                            _remotepairingAllowPromptlessPairing,
                            _remotepairing_delete_pair_record,
                            _remotepairing_delete_pair_records,
                            _remotepairing_delete_pair_records_with_options ]
    objc-classes:         [ RPDeviceKeyValueStore_Internal, RPPairableHost,
                            RPPairableHostBrowser, RPPairingChallenge,
                            RPRSDDeviceInfo_Internal, RPWirelessPairingSession,
                            RPWirelessPairingSession_Internal,
                            _TtC19RemotePairingDevice42RemotePairingDeviceTunnelServiceConnection,
                            _TtC19RemotePairingDevice43ControlChannelConnectionWireProtocolVersion,
                            _TtC19RemotePairingDevice43RemotePairingDevicePairingServiceConnection ]
    objc-ivars:           [ RPWirelessPairingSession._underlyingObject ]
...
