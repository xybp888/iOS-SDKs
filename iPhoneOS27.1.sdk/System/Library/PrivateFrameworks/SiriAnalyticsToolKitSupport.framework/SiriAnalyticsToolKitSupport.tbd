--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/SiriAnalyticsToolKitSupport.framework/SiriAnalyticsToolKitSupport
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _FFTSchemaFFTWrapperReadFrom,
                            _FFTSchemaRegistrationDataReadFrom,
                            _FFTSchemaRegistrationErrorReadFrom ]
    objc-classes:         [ FFTSchemaFFTWrapper, FFTSchemaRegistrationData,
                            FFTSchemaRegistrationError ]
    objc-ivars:           [ FFTSchemaFFTWrapper._errors,
                            FFTSchemaFFTWrapper._fftId, FFTSchemaFFTWrapper._has,
                            FFTSchemaFFTWrapper._hasFftId,
                            FFTSchemaFFTWrapper._numTools,
                            FFTSchemaFFTWrapper._numTypedValues,
                            FFTSchemaFFTWrapper._skippedMessages,
                            FFTSchemaFFTWrapper._taggedMessages,
                            FFTSchemaRegistrationData._classifiedString,
                            FFTSchemaRegistrationData._entityName,
                            FFTSchemaRegistrationData._hasClassifiedString,
                            FFTSchemaRegistrationData._hasEntityName,
                            FFTSchemaRegistrationData._hasPropertyName,
                            FFTSchemaRegistrationData._hasTagMetadata,
                            FFTSchemaRegistrationData._hasToolId,
                            FFTSchemaRegistrationData._propertyName,
                            FFTSchemaRegistrationData._tagMetadata,
                            FFTSchemaRegistrationData._toolId,
                            FFTSchemaRegistrationError._errorMessage,
                            FFTSchemaRegistrationError._hasErrorMessage,
                            FFTSchemaRegistrationError._hasRegistration,
                            FFTSchemaRegistrationError._registration ]
...
