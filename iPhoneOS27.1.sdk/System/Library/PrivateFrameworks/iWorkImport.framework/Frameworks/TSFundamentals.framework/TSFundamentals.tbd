                            _TSUClassAndProtocolCast, _TSUCrashBreakpoint,
                            _TSUDefaultCat, _TSUDefaultCat_init_token,
                            _TSUDefaultCat_log_t, _TSUDynamicCast, _TSUErrorCat,
                            _TSUErrorCat_init_token, _TSUErrorCat_log_t,
                            _TSULogBacktrace, _TSULogCreateCategory,
                            _TSUProtocolCast, _TSUProtocolHasInstanceMethod,
                            _TSUSetCrashReporterInfo, _TSUSetCrashReporterInfov,
                            _TSUSpecificCast, _TSUWarningCat,
                            _TSUWarningCat_init_token, _TSUWarningCat_log_t ]
    objc-classes:         [ TSUAssertionHandler ]
...
