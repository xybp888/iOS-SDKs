--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/HearingCore.framework/HearingCore
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _AXHAMessageKeyIdentifier, _AXHAMessageKeyPayload,
                            _AXHANULL, _AXHearingAidServerName,
                            _AXInCallServiceName, _HCAXUILaunchAngelProcessName,
                            _HCAXUIServerProcessName,
                            _HCApplicationGetMainBundleIdentifier,
                            _HCCarouselProcessName, _HCDeviceGetType,
                            _HCHandoffUserRequested, _HCHealthBundleName,
                            _HCHeardBundleName, _HCHeardProcessName,
                            _HCHearingDeviceNameKey,
                            _HCHearingWidgetBundleIdentifier,
                            _HCLogAudioAccommodations, _HCLogComfortSounds,
                            _HCLogHearing, _HCLogHearingAidWidgets,
                            _HCLogHearingAids, _HCLogHearingHandoff,
                            _HCLogHearingLiveListen, _HCLogHearingNearby,
                            _HCLogHearingNearbyIDS, _HCLogHearingProtection,
                            _HCLogHearingRelevance, _HCLogHearingXPC,
                            _HCLogSoundMeter, _HCMessageDeviceNameKey,
                            _HCMessageUUIDKey, _HCPeerNameKey, _HCPerformSafeBlock,
                            _HCPreferencesBundleName, _HCProcessGetName,
                            _HCRTTNotificationContentExtensionName, _HCReasonKey,
                            _HCSpringBoardProcessName, _HearingCoreVersionNumber,
                            _HearingCoreVersionString,
                            _kAXSPairedHearingUUIDsPreference, _kAdjust0DB,
                            _messageIdentifierDescription ]
    objc-classes:         [ HCDatabaseManager, HCServer, HCSettings,
                            HCSettingsListenerHelper, HCUtilities, HCXPCClient,
                            HCXPCMessage ]
    objc-ivars:           [ HCDatabaseManager._contentProtectionNotifyToken,
                            HCDatabaseManager._managedObjectContext,
                            HCServer._connectionQueue, HCServer._deadConnection,
                            HCServer._delegate, HCServer._messageDelegate,
                            HCServer._responseBlocks, HCServer._xpcConnection,
                            HCSettings._domainAccessor,
                            HCSettings._globalDomainAccessor,
                            HCSettings._nanoDomainAccessorQueue,
                            HCSettings._registeredNotifications,
                            HCSettings._syncLock,
                            HCSettings._synchronizePreferences,
                            HCSettings._updateBlocks,
                            HCSettingsListenerHelper._delegate,
                            HCSettingsListenerHelper._listenerAddress,
                            HCSettingsListenerHelper._selectorKeys,
                            HCXPCClient._requestedScanning,
                            HCXPCClient._requestedUpdates,
                            HCXPCClient._xpcConnection, HCXPCClient._xpcQueue,
                            HCXPCMessage._client, HCXPCMessage._error,
                            HCXPCMessage._payload, HCXPCMessage._xpcMessage ]
...
