--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/AppleCV3DMOVKit.framework/AppleCV3DMOVKit
current-version:       9.26.7
compatibility-version: 9.26.7
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _CVPixelBufferAttachmentIntrinsicsKey,
                            _kALSIdentifierPrefixValue,
                            _kAVMetadataIdentifierCalibration,
                            _kAVMetadataIdentifierDeviceInfoVRA,
                            _kAVMetadataIdentifierFrameworkState,
                            _kAVMetadataIdentifierRecordingEnvironment,
                            _kAVMetadataIdentifierRecordingEnvironmentVRA,
                            _kAccelerometerIdentifierValue,
                            _kBLEIdentifierPrefixValue,
                            _kBarometerIdentifierValue, _kCMDataIdentifierValue,
                            _kCVACameraCalibrationIdentifierValue,
                            _kCVADepthIRIdentifierValue,
                            _kCVADepthTOFIdentifierValue,
                            _kCVAFeatureBufferFormatValue,
                            _kCVAFeatureBufferIdentifierValue,
                            _kCVAPRDeviceIdentifierValue,
                            _kCVATimedValueIdentifierValue,
                            _kCVAUserEventIdentifierValue,
                            _kCameraExposureTimeKey, _kCompassIdentifierValue,
                            _kCoreLocationIdentifierValue, _kDepthFrameRate,
                            _kDepthMaxPoints, _kDepthTOFIdentifierValue,
                            _kDepthTOFIdentifierValue2_3,
                            _kDepthTOFIdentifierValueVRA,
                            _kGyroscopeIdentifierValue,
                            _kIMUMotionIdentifierValue,
                            _kIMUMotionIdentifierValue2_3, _kJasperCalibData,
                            _kJasperCalibDataVRA, _kMDDExtrinsics,
                            _kMOVSummaryBundleID, _kMOVSummaryDeviceName,
                            _kMOVSummaryDeviceString,
                            _kMOVSummaryJasperExtrinsics,
                            _kMOVSummaryMOVKitVersion,
                            _kMOVSummaryOSBuildVersion,
                            _kMOVSummaryProductConfig, _kMOVSummaryProductType,
                            _kMOVSummaryProductVersion,
                            _kMOVSummarySWtoWExtrinsics,
                            _kMOVSummarySerialNumber, _kMOVSummaryVersion,
                            _kMOVSummaryiOS, _kMotionIdentifierValue,
                            _kOriginalPresentationTimeStamp,
                            _kRawALSIdentifierPrefixValue,
                            _kRawAccelerometerIdentifierValue,
                            _kRawCompassIdentifierValue,
                            _kRawGyroscopeIdentifierValue,
                            _kSTFirmwareVersionData, _kSTFirmwareVersionDataVRA,
                            _kSpuIMUIdentifierValue, _kSpuIMUVersionKey,
                            _kTrackClassKey, _kTrackNameDeviceTransform_V2_3,
                            _kTrackVersionKey, _kUWBIdentifierPrefixValue,
                            _kUnitInfoData, _kUnitInfoDataVRA,
                            _kUserEventIdentifierValue2_2,
                            _kWiFiIdentifierPrefixValue ]
    objc-classes:         [ AppleCV3DMOVKitLog, CMData, CMDataContainer, CMEvent,
                            CMFileInterface, CMMessage, CVACLLocation,
                            CVACLMotionTypeDoubleVector3,
                            CVACLMotionTypeDoubleVector4, CVACLMotionTypeVector3,
                            CVACLMotionTypeVector4, CVACMALSData,
                            CVACMAccelerometerData, CVACMBLEData,
                            CVACMBarometerData, CVACMCompassData,
                            CVACMDeviceMotionData, CVACMGyroData, CVACMMotionData,
                            CVACMMotionTypeDeviceMotionData, CVACMUWBData,
                            CVACMWiFiData, CVACalibration, CVACameraCalibration,
                            CVACameraCalibrationData, CVADepthIR, CVADepthTOF,
                            CVAFeatureBuffer, CVAIMUCalibration,
                            CVAJasperDepthFrameProcessor, CVAMetadataWrapper,
                            CVAMetadataWrapperTracks, CVAPRAngleMeasurement,
                            CVAPRDevice, CVAPRRangeMeasurement,
                            CVAPeridotDepthFrameProcessor,
                            CVASpuFastPathComboAxisData, CVATimedValue,
                            CVAUserEvent, MIOWriterInterface,
                            MIOWriterInterfaceStreamEncodingObject,
                            MOVReaderInterface, MOVWriterInterface,
                            MOVWriterInterfaceStreamEncodingObject,
                            MOVWriterInterfaceUtil ]
...
