--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/HearingRelevance.framework/HearingRelevance
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios ]
    symbols:              [ _HRSoundDetectionTypeApplianceBeeps,
                            _HRSoundDetectionTypeApplianceBellDings,
                            _HRSoundDetectionTypeApplianceBuzzes,
                            _HRSoundDetectionTypeCarHorns,
                            _HRSoundDetectionTypeCatMeows,
                            _HRSoundDetectionTypeCough,
                            _HRSoundDetectionTypeDistressedBaby,
                            _HRSoundDetectionTypeDogBarks,
                            _HRSoundDetectionTypeDoorKnocks,
                            _HRSoundDetectionTypeDoorbells,
                            _HRSoundDetectionTypeFireAlarms,
                            _HRSoundDetectionTypeGlassBreaking,
                            _HRSoundDetectionTypeKShot,
                            _HRSoundDetectionTypeKettle,
                            _HRSoundDetectionTypeNone,
                            _HRSoundDetectionTypePersonShouting,
                            _HRSoundDetectionTypeSirenAlarms,
                            _HRSoundDetectionTypeSmokeAlarms,
                            _HRSoundDetectionTypeWaterRunning,
                            _HearingRelevanceVersionNumber,
                            _HearingRelevanceVersionString ]
...
