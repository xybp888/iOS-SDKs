    symbols:              [ _NSStringFromWRReloadReason,
                            _WRRegisterForChronodStartup,
                            _WidgetRendererVersionNumber,
                            _WidgetRendererVersionString ]
    objc-classes:         [ WRObjcUtilities,
                            WRWidgetRendererInitializationPayload,
                            WRWidgetRendererSessionKey,
                            _TtC14WidgetRenderer12WidgetWindow,
                            _TtC14WidgetRenderer16_WRUIAppDelegate,
                            _TtC14WidgetRenderer16_WRUIApplication,
                            _TtC14WidgetRenderer19WidgetSceneDelegate,
                            _TtC14WidgetRenderer19_JindoAccessoryView,
                            _TtC14WidgetRenderer20AmbientSceneDelegate,
                            _TtC14WidgetRenderer20TouchPassThroughView,
                            _TtC14WidgetRenderer20WidgetRendererClient,
                            _TtC14WidgetRenderer21ActivitySceneDelegate,
                            _TtC14WidgetRenderer21ListItemSceneDelegate,
                            _TtC14WidgetRenderer21WidgetSceneConnection,
                            _TtC14WidgetRenderer22ActivityRendererClient,
                            _TtC14WidgetRenderer23SecureHostingController,
                            _TtC14WidgetRenderer24_EmptyJindoAccessoryView,
                            _TtC14WidgetRenderer25ActivitySceneDelegateBase,
                            _TtC14WidgetRenderer26DebugOverlayViewController,
                            _TtC14WidgetRenderer26JindoActivitySceneDelegate,
                            _TtC14WidgetRenderer27ActivityBannerSceneDelegate,
                            _TtC14WidgetRenderer27AmbientCompactSceneDelegate,
                            _TtC14WidgetRenderer27SingleActivitySceneDelegate,
                            _TtC14WidgetRenderer28ActivityTestingSceneDelegate,
                            _TtC14WidgetRenderer28CarPlayActivitySceneDelegate,
                            _TtC14WidgetRenderer28PreviewHostingViewController,
                            _TtC14WidgetRenderer29ZStackContainerViewController,
                            _TtC14WidgetRenderer29_JindoAccessoryViewController,
                            _TtC14WidgetRenderer31BaseWidgetContentViewController,
                            _TtC14WidgetRenderer31DataProtectionSuspensionMonitor,
                            _TtC14WidgetRenderer31LiveWidgetContentViewController,
                            _TtC14WidgetRenderer32WidgetSceneContentViewController,
                            _TtC14WidgetRenderer34ActivitySceneContentViewController,
                            _TtC14WidgetRenderer35SystemApertureElementViewController,
                            _TtC14WidgetRenderer36ActivityPreviewHostingViewController,
                            _TtC14WidgetRenderer41_UserInterfaceStyleSceneComponentProvider,
                            _TtC14WidgetRenderer50WatchComplicationsWidgetSceneContentViewController ]
    objc-ivars:           [ WRWidgetRendererInitializationPayload._configurations,
                            WRWidgetRendererInitializationPayload._extensions,
                            WRWidgetRendererInitializationPayload._systemEnvironment,
                            WRWidgetRendererSessionKey._identifier,
                            WRWidgetRendererSessionKey._metrics,
                            WRWidgetRendererSessionKey._widget ]
...
