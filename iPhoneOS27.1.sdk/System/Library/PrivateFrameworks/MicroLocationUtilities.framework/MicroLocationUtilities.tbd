                            ULDarwinNotificationHelper,
                            ULDarwinNotificationRecord, ULEvent, ULEventMonitor,
                            ULFeatureFlags, ULFuture, ULImmediateScheduler,
                            ULMemoryLoadHelper, ULNumericUtilities,
                            ULObjectCacheNSString, ULObserverRecord, ULPair,
                            ULPlatform, ULPromise, ULQueueScheduler,
                            ULRotationMatrixUtils, ULSameSpaceUtilities,
                            ULScheduler, ULTapToRadar, ULTimer, ULTimerFactory,
                            ULUserNotification, ULWeakProxy ]
    objc-ivars:           [ ULBidirectionalDictionary._keyToValueMap,
                            ULBidirectionalDictionary._valueToKeyMap,
                            ULDarwinNotificationHelper._queue,
                            ULDarwinNotificationHelper._registrations,
                            ULDarwinNotificationRecord._handler,
                            ULDarwinNotificationRecord._notificationName,
                            ULDarwinNotificationRecord._registrationToken,
                            ULEventMonitor._observersMap, ULEventMonitor._queue,
                            ULFuture._completionBlocks, ULFuture._error,
                            ULFuture._result, ULFuture._stateLock,
                            ULMemoryLoadHelper._pid, ULMemoryLoadHelper._rusage,
                            ULObserverRecord._handler,
                            ULObserverRecord._observer, ULPair._first,
                            ULPair._second, ULPromise._future,
                            ULQueueScheduler._queue, ULTimer._timerSource,
                            ULTimerFactory._primaryQueue, ULWeakProxy._class,
                            ULWeakProxy._object ]
...
