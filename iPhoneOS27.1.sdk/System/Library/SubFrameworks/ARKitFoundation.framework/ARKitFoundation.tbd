--- !tapi-tbd
tbd-version:     4
targets:         [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
install-name:    '/System/Library/SubFrameworks/ARKitFoundation.framework/ARKitFoundation'
exports:
  - targets:         [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:         [ _ARDepthCameraCalibrationCopy, _ARDepthCameraCalibrationCreate, 
                       _ARDepthCameraCalibrationGetDeviceTransform, _ARDepthCameraCalibrationGetExtrinsics, 
                       _ARDepthCameraCalibrationGetIntrinsics, _ARDepthCameraCalibrationGetSLAMReinitCount, 
                       _ARDepthCameraCalibrationGetSLAMSessionID, _ARDepthCameraCalibrationGetTimestamp, 
                       _ARDepthCameraCalibrationRelease, _ARDepthCameraCalibrationSetDeviceTransform, 
                       _ARDepthCameraCalibrationSetExtrinsics, _ARDepthCameraCalibrationSetIntrinsics, 
                       _ARDepthCameraCalibrationSetSLAMReinitCount, _ARDepthCameraCalibrationSetSLAMSessionID, 
                       _ARDepthCameraCalibrationSetTimestamp, _ARDepthCameraCalibrationSize, 
                       _ARKitFoundationBuildVersionString ]
    objc-classes:    [ ARDepthData, ARFormattedStringCache ]
...
