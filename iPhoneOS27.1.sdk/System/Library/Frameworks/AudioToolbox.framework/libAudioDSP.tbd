--- !tapi-tbd
tbd-version:     4
targets:         [ arm64e-ios, arm64e.x1-ios ]
install-name:    '/System/Library/Frameworks/AudioToolbox.framework/libAudioDSP.dylib'
exports:
  - targets:         [ arm64e-ios, arm64e.x1-ios ]
    symbols:         [ _DNNVAD_CreateInstance, _DNNVAD_DestroyInstance, _DNNVAD_EnableLegacyVAD, 
                       _DNNVAD_GetPowerMeterValue, _DNNVAD_GetSoundActivityValue, 
                       _DNNVAD_GetSpeechProbabilityHardValue, _DNNVAD_GetSpeechProbabilitySoftValue, 
                       _DNNVAD_Initialize, _DNNVAD_IsInitialized, _DNNVAD_Process, 
                       _DNNVAD_Uninitialize, _GetAudioDSPManager, _RegisterAUVoiceIsolation_Unsearchable, 
                       _RegisterAudioUnits_Analyzer, _RegisterAudioUnits_Internal, 
                       _RegisterAudioUnits_InternalUnsearchable, _RegisterMovieRemixAUs_Unsearchable, 
                       _RegisterPublicAudioUnits, _gSpatialMetadataSPI ]
...
