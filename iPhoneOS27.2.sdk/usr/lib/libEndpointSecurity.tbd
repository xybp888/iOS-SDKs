                            _es_exec_entitlements, _es_exec_env,
                            _es_exec_env_count, _es_exec_fd, _es_exec_fd_count,
                            _es_free_message, _es_get_deadline_max_milliseconds,
                            _es_get_deadline_min_milliseconds,
                            _es_get_deadline_miss_mode, _es_invert_muting,
                            _es_invert_path_match, _es_kext_variant,
                            _es_list_processes, _es_message_size, _es_mute_path,
                            _es_mute_path_events, _es_mute_path_literal,
                            _es_mute_path_prefix, _es_mute_process,
