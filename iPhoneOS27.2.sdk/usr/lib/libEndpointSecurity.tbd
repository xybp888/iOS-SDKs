--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
flags:                 [ flat_namespace ]
install-name:          /usr/lib/libEndpointSecurity.dylib
current-version:       0
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:              [ _es_clear_cache, _es_copy_message,
                            _es_default_mute_path, _es_default_mute_path_events,
