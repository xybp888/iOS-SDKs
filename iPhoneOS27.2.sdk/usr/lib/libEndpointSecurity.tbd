                            _es_new_descendants_client,
                            _es_policy_protect_client, _es_power_down,
                            _es_power_up, _es_release_message,
                            _es_release_muted_paths, _es_release_muted_processes,
                            _es_release_process_list, _es_respond_auth_result,
                            _es_respond_flags_result, _es_retain_message,
                            _es_set_deadline_max_milliseconds,
                            _es_set_deadline_min_milliseconds,
                            _es_set_deadline_miss_mode, _es_set_mprotect_policy,
                            _es_subscribe, _es_subscriptions, _es_sync_client,
                            _es_unmute_all_paths, _es_unmute_all_target_paths,
                            _es_unmute_path, _es_unmute_path_events,
                            _es_unmute_process, _es_unmute_process_events,
                            _es_unmute_process_options, _es_unsubscribe,
                            _es_unsubscribe_all,
                            _sysdiagnoseInformationForEndpointSecurity ]
