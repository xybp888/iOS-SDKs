--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/FitnessCoachingServices.framework/FitnessCoachingServices
current-version:       1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:              [ _FCSAchievementLocalizationBundle,
                            _FCSAchievementProgressHalfway,
                            _FCSAchievementProgressOneDayAway,
                            _FCSAchievementProgressQuarterIn,
                            _FCSAchievementProgressThreeDaysAway,
                            _FCSAchievementProgressThreeQuartersIn,
                            _FCSFirstGlanceAchievementCanCoachWithProgressAndGoal,
                            _FCSFirstGlanceAchievementIsLongestMoveStreakAchievement,
                            _FCSFirstGlanceAchievementValueIsLessThanTargetValue,
                            _FCSFirstGlanceAchievementValueIsMultipleOfTargetValue,
                            _FCSFirstGlanceDaysRemainingInFitnessWeek,
                            _FCSFirstGlanceProgressAchievementIdentifierOverridePreferenceKey,
                            _FCSFirstGlanceProgressMilestoneOverridePreferenceKey,
                            _FCSFirstGlanceRankingForAchievement,
                            _FCSProgressAchievementLocalizationPrefixFormatString,
                            _FCSTodayEarnedAchievementLocalizationPrefixFormatString,
                            _FCSYesterdayEarnedAchievementLocalizationPrefixFormatString ]
    objc-classes:         [ FCSFitnessCoachingAchievementEvaluator,
                            FCSWeeklyGoalRecommendationEngine,
                            _TtC23FitnessCoachingServices13SleepObserver,
                            _TtC23FitnessCoachingServices18TypicalDayProvider,
                            _TtC23FitnessCoachingServices21AchievementDataSource,
                            _TtC23FitnessCoachingServices22WalkSuggestionProvider ]
    objc-ivars:           [ FCSFitnessCoachingAchievementEvaluator._dataSource,
                            FCSFitnessCoachingAchievementEvaluator._progressLocalizationKeyOverride,
                            FCSFitnessCoachingAchievementEvaluator._todayLocalizationKeyOverride,
                            FCSFitnessCoachingAchievementEvaluator._yesterdayLocalizationKeyOverride ]
...
