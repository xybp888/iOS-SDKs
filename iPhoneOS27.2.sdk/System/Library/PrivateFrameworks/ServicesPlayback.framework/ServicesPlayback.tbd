    symbols:              [ _ServicesPlaybackVersionNumber,
                            _ServicesPlaybackVersionString ]
    objc-classes:         [ _TtC16ServicesPlayback15PlayerLayerView,
                            _TtC16ServicesPlayback21SubtitlesMenuDelegate,
                            _TtC16ServicesPlayback23SubtitlesMenuAnchorView ]
...
