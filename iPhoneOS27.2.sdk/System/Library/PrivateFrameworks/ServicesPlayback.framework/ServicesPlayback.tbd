--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/ServicesPlayback.framework/ServicesPlayback
