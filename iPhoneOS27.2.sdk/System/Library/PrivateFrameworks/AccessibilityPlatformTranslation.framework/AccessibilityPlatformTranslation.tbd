                            AXPRemoteCacheManager._cachedTreeClientType,
                            AXPRemoteCacheManager._failedSendAttempts,
                            AXPRemoteCacheManager._lastAXTreeFullyGenerated,
                            AXPRemoteCacheManager._transportDelegate,
                            AXPRemoteCacheManager._treeDumpStatus,
                            AXPRuntimeDelegateRegistration._cachedTreeClientType,
                            AXPRuntimeDelegateRegistration._delegate,
                            AXPRuntimeDelegateRegistration._requestResolvingBehavior,
                            AXPTokenDelegateRegistration._cachedTreeClientType,
                            AXPTokenDelegateRegistration._delegate,
                            AXPTokenDelegateRegistration._requestResolvingBehavior,
                            AXPTranslationObject._bridgeDelegateToken,
                            AXPTranslationObject._didPopuldateAppInfo,
                            AXPTranslationObject._isApplicationElement,
                            AXPTranslationObject._objectID,
                            AXPTranslationObject._pid,
                            AXPTranslationObject._rawElementData,
                            AXPTranslationObject._remoteDebugDescription,
                            AXPTranslationObject._remoteDescriptionBlock,
                            AXPTranslator._accessibilityEnabled,
                            AXPTranslator._authoritativeBridgeDelegateToken,
                            AXPTranslator._authoritativeRuntimeDelegateToken,
                            AXPTranslator._axTreeDumpSharedBackgroundQueue,
                            AXPTranslator._bridgeDelegate,
                            AXPTranslator._bridgeDelegateAuthorityGeneration,
                            AXPTranslator._bridgeDelegateTokenToRegistrationLookup,
                            AXPTranslator._bridgeDelegateTokenToTreeDumpLookup,
                            AXPTranslator._bridgeTokenDelegate,
                            AXPTranslator._cachedTreeClientType,
                            AXPTranslator._fakeElementCache,
                            AXPTranslator._registrationLookupLock,
                            AXPTranslator._requestResolvingBehavior,
                            AXPTranslator._runtimeDelegate,
                            AXPTranslator._runtimeDelegateAuthorityGeneration,
                            AXPTranslator._runtimeDelegateTokenToRegistrationLookup,
                            AXPTranslator._supportsDelegateTokens,
                            AXPTranslator._systemAppDelegate,
                            AXPTranslator._textEditingTranslationObj,
