                            AXPTranslatorResponse._associatedTranslationObject,
                            AXPTranslatorResponse._attribute,
                            AXPTranslatorResponse._error,
                            AXPTranslatorResponse._notification,
                            AXPTranslatorResponse._resultData,
                            AXPTranslator_iOS._accessibilityEnabled,
                            AXPTranslator_iOS._axAppReadyFlag,
                            AXPTranslator_iOS._axEventObserver,
                            AXPTranslator_iOS._axTreeDumpCompletionHandler,
                            AXPTranslator_iOS._axTreeDumpCurrentChildIndex,
                            AXPTranslator_iOS._axTreeDumpCurrentOutput,
                            AXPTranslator_iOS._axTreeDumpCurrentType,
