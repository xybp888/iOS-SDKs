                            AXPRemoteCacheManager.__axHierarchyGenerationQueue,
                            AXPRemoteCacheManager.__cachedTranslationsForLayoutChange,
                            AXPRemoteCacheManager.__layoutChangeCoalesceTimer,
                            AXPRemoteCacheManager.__runtimeDelegateToken,
