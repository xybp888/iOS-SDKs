--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/AccessibilityPlatformTranslation.framework/AccessibilityPlatformTranslation
current-version:       591.4.5
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:              [ _AXPConvertValue, _AXPCustomActionIdentifier,
                            _AXPCustomActionName, _AXPCustomRotorDirection,
                            _AXPCustomRotorName, _AXPCustomRotorSystemType,
                            _AXPCustomRotorTargetElement,
                            _AXPCustomRotorTargetRange, _AXPCustomRotorUUID,
                            _AXPFontAttributeName,
                            _AXPForegroundColorAttributeName, _AXPIsCatalyst,
                            _AXPIsGoodOldAppleCatalystApp, _AXPIsiOSAppOnMac,
                            _AXPLinkedOnOrAfterGozul, _AXPNilOrEmptyString,
                            _AXPOriginalFontAttributeName,
                            _AXPParagraphStyleAttributeName,
                            _AXPParametersDictActionsKey,
                            _AXPParametersDictAttributesKey,
                            _AXPSearchStartElementKey, _AXPShadowAttributeName,
                            _AXPTextAlternativesAttributeName,
                            _AXPTextEffectAttributeName,
                            _AXPTreeDumpTypeAdditionalData,
                            _AXPTreeDumpTypeInitialDump,
                            _AXPTreeDumpTypeTreeDestroyed, __AXPActionToString,
                            __AXPAttributeToString, __AXPNotificationToString ]
