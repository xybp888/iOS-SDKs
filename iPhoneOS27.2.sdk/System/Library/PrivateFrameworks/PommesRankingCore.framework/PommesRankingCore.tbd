--- !tapi-tbd
tbd-version:           4
targets:               [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
flags:                 [ flat_namespace ]
install-name:          /System/Library/PrivateFrameworks/PommesRankingCore.framework/PommesRankingCore
current-version:       6.1.1
compatibility-version: 1
exports:
  - targets:              [ armv7-ios, armv7s-ios, arm64-ios, arm64e-ios, arm64e.x1-ios ]
    symbols:              [ _PRBuildQueryTree, _PRSetLogObjects,
                            _ProcessPommesQuery, _bundleIDTypeForBundleID,
                            _bundleIDTypeMaskForBundleIDs,
                            _bundleIDTypeMaskForMDS,
                            _constructCQueryRewritesDictBridge,
                            _isCerberusEnabled, _isLLMEnabled, _isMailClient,
                            _isMessagesClient, _isPhotosClient, _isPommesCtl,
                            _isQUEnabled, _isSearchToolClient,
                            _isSearchToolDebugModeEnabled,
                            _isSemanticIndexEnabled, _isSettingsClient,
                            _isSpotlightUIClient, _isSupportedCommandLineTool,
                            _isTextSemanticSearchEnabled, _isValidPommesQuery,
                            _isWalletClient,
                            _isWalletDocumentUnderstandingEnabled,
                            _peopleNameAliasForName, _stringForPRBundleIDType ]
    objc-classes:         [ AssetsLoadUtils, PRASTStackItem, PRAstBuilder,
                            PRAstCompositeNode, PRAstFieldNode, PRAstKeywordInfo,
                            PRAstLanguageProfile, PRAstNode, PRAstQPFilterNode,
                            PRAstTermNode, PRQueryNumberFormatters,
                            PRQuerySynonymsProvider, PRStackItem ]
    objc-ivars:           [ PRASTStackItem._node, PRASTStackItem._visited,
                            PRAstBuilder._context, PRAstBuilder._languageProfile,
                            PRAstBuilder._logHeader, PRAstBuilder._originalQuery,
                            PRAstBuilder._qpParsesDesc,
                            PRAstBuilder._qpParsesRange,
                            PRAstBuilder._specialIndices,
                            PRAstBuilder._tokenRanges,
                            PRAstBuilder._tokenToFilterMap,
                            PRAstBuilder._tokenToU2LabelsMap,
                            PRAstBuilder._tokens, PRAstBuilder._u2TokensLabel,
                            PRAstBuilder._u2TokensRange,
                            PRAstCompositeNode._children,
                            PRAstCompositeNode._nodeType,
                            PRAstFieldNode._expression,
                            PRAstFieldNode._fieldType, PRAstFieldNode._isIgnored,
                            PRAstFieldNode._originalKeyword,
                            PRAstKeywordInfo._direction,
                            PRAstKeywordInfo._fieldType,
                            PRAstLanguageProfile._isSpaceDelimited,
                            PRAstLanguageProfile._keywordInfo,
                            PRAstLanguageProfile._languageCode,
                            PRAstNode._isLastToken, PRAstNode._sourceToken,
                            PRAstQPFilterNode._filterString,
                            PRAstTermNode._isIgnored, PRAstTermNode._isNegated,
                            PRAstTermNode._value,
                            PRQueryNumberFormatters._currencyDecimalFormatter,
                            PRQueryNumberFormatters._currencyFormatter,
                            PRQueryNumberFormatters._decimalFormatter,
                            PRQueryNumberFormatters._locale,
                            PRQueryNumberFormatters._numberFormatter,
                            PRQuerySynonymsProvider._homeSynonyms,
                            PRQuerySynonymsProvider._mailSynonyms,
                            PRStackItem._node, PRStackItem._visited ]
...
